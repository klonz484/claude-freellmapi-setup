# FreeLLMAPI environment example
# Copy to .env and fill in values if you self-host

# Required for encryption of stored provider keys
ENCRYPTION_KEY=generate-with-openssl-rand-hex-32

# Port the gateway listens on (default 3001)
PORT=3001

# Optional: hand off a short context note when the router switches models mid-session
FREELLMAPI_CONTEXT_HANDOFF=on_model_switch

# Optional: used by the CLI helpers
# FREELLMAPI_URL=http://localhost:3001
# FREELLMAPI_API_KEY=freellmapi-your-unified-key
