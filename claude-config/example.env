# Example environment variables for Claude Code + FreeLLMAPI
# Source this file or export the variables before running `claude`

# Point Claude Code at your FreeLLMAPI gateway
# Desktop app usually uses 31415, Docker/self-host usually 3001
export ANTHROPIC_BASE_URL="http://localhost:3001"

# Your unified FreeLLMAPI key (starts with freellmapi-)
export ANTHROPIC_AUTH_TOKEN="freellmapi-YOUR_KEY_HERE"

# Optional: disable Claude Code's own auto-mode classifier billing check
# (useful when routing through FreeLLMAPI)
export CLAUDE_CODE_AUTO_MODE_SERVER=0
